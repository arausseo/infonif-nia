# ─── Modelo ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── API de Infonif ────────────────────────────────────────────────────────────
# Es el origen real de los datos: conteos, segmentos y autocompletado.
# Alcanzable desde internet. Ver docs/API-INFONIF.md.
#
# La apikey NO es un secreto: viaja en el bundle público del buscador actual.
# Vive aquí para poder rotarla sin tocar código, no para protegerla.
INFONIF_API_URL=https://bbdd-api.infonif.es/api
INFONIF_API_KEY=
INFONIF_TIEMPO_LIMITE_MS=45000

# El resumen de facetas tarda ~26 s y sus datos cambian una vez al dia.
# TTL = cuanto se considera fresco. Pasado ese tiempo NO se descarta: se sigue
# sirviendo mientras se refresca por detras, para que nadie espere 26 segundos.
INFONIF_RESUMEN_TTL_SEGUNDOS=86400
# Red de seguridad en Redis, muy por encima del TTL.
INFONIF_RESUMEN_CADUCIDAD_SEGUNDOS=604800

# Catálogo de campos comprables. Se baja de fields.json (ADR-011). Cambia poco,
# pero cuando cambia son PRECIOS: no conviene alargarlo.
INFONIF_CATALOGO_TTL_SEGUNDOS=86400
INFONIF_CATALOGO_CADUCIDAD_SEGUNDOS=604800

# ─── SQL Server (solo lectura) ─────────────────────────────────────────────────
# INCÓGNITA: si el servidor es 2012 o anterior, OpenSSL 3 de Debian 12 rechaza el
# handshake. Por eso encrypt y trustServerCertificate son configurables.
MSSQL_HOST=localhost
MSSQL_PUERTO=1433
MSSQL_USER=sa
MSSQL_PASSWORD=Nia_Local_2026!
MSSQL_DATABASE=infonif
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Pagos (modo prueba) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Puente de sesión con el ASP Classic ───────────────────────────────────────
# El ASP lo usa para acuñar tokens contra POST /internal/mint.
AGENT_SHARED_SECRET=cambia-esto-antes-de-desplegar
TOKEN_TTL_SEGUNDOS=900

# ─── Trazas ────────────────────────────────────────────────────────────────────
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Servicio ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PUERTO=3000
LOG_NIVEL=info
ORIGENES_PERMITIDOS=http://localhost:5174
