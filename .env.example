# ─── Modelo ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Elasticsearch ─────────────────────────────────────────────────────────────
# INCÓGNITA: el clúster real es 6.x o 7.x, distribución OSS. En 6.x la ruta de
# búsqueda lleva el tipo. Lo aísla datos/elastic/rutas.ts.
ES_URL=http://localhost:9200
ES_INDICE=empresas
ES_VERSION=7

# ─── SQL Server (solo lectura) ─────────────────────────────────────────────────
# INCÓGNITA: si el servidor es 2012 o anterior, OpenSSL 3 de Debian 12 rechaza el
# handshake. Por eso encrypt y trustServerCertificate son configurables.
MSSQL_HOST=localhost
MSSQL_PUERTO=1433
MSSQL_USER=sa
MSSQL_PASSWORD=Nia_Local_2026!
MSSQL_DATABASE=infonif
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Pagos (modo prueba) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Puente de sesión con el ASP Classic ───────────────────────────────────────
# El ASP lo usa para acuñar tokens contra POST /internal/mint.
AGENT_SHARED_SECRET=cambia-esto-antes-de-desplegar
TOKEN_TTL_SEGUNDOS=900

# ─── Trazas ────────────────────────────────────────────────────────────────────
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Servicio ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PUERTO=3000
LOG_NIVEL=info
ORIGENES_PERMITIDOS=http://localhost:5174
